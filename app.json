{
  "expo": {
    "name": "ShroomLock",
    "slug": "shroomlock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shroomlock.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F1EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.shroomlock.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F6F1EA",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#15110E"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# ShroomLock native modules (app lock, Play Billing): keep as-is for the Expo module registry.\n-keep class expo.modules.appblocker.** { *; }\n-keep class expo.modules.playbilling.** { *; }\n"
          }
        }
      ]
    ],
    "scheme": "shroomlock",
    "experiments": {
      "typedRoutes": true
    }
  }
}
